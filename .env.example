APP_NAME="FM Finance API"
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/fm_finance_finance
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=fm-platform-api
JWT_AUDIENCE=fm-frontend
JWT_TTL_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PREFIX=
GOOGLE_APPLICATION_CREDENTIALS=
LOG_LEVEL=INFO
OPERATIONAL_SERVICE_URL=http://127.0.0.1:8001
OPERATIONAL_INTERNAL_API_KEY=replace-with-the-operational-internal-key
OPERATIONAL_TIMEOUT_SECONDS=5

# local | gcs
EXPORT_STORAGE_BACKEND=local
EXPORT_STORAGE_DIR=storage/exports
# gcs only; empty = GOOGLE_CLOUD_STORAGE_BUCKET / GOOGLE_CLOUD_STORAGE_PREFIX
EXPORT_GCS_BUCKET=
EXPORT_GCS_PREFIX=
EXPORT_MAX_AUTOMATIC_ATTEMPTS=3
EXPORT_GENERATION_TIMEOUT_MINUTES=15
CUTOFF_JOB_TIMEOUT_MINUTES=60